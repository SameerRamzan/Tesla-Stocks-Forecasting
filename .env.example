# Environment variables for local development
# Copy to .env and customize for your environment

# Database
DATABASE_URL=postgresql+asyncpg://tesla_user:tesla_password@localhost:5432/tesla_forecasting
DATABASE_URL_SYNC=postgresql://tesla_user:tesla_password@localhost:5432/tesla_forecasting

# Redis
REDIS_URL=redis://localhost:6379/0

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# API Configuration
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_STR=/api/v1
PROJECT_NAME=Tesla Forecasting API
PROJECT_VERSION=0.1.0

# CORS
ALLOWED_ORIGINS=["http://localhost:8501", "http://localhost:3000", "http://localhost:8080"]

# Data Sources
YFINANCE_SYMBOL=TSLA
DEFAULT_INTERVAL=1d

# Model Configuration
MODEL_REGISTRY_STAGE=Production
FORECAST_HORIZONS=[1,5,10,20]

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Storage (for production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=tesla-forecasting-data
# S3_REGION=us-east-1

# Google Cloud (alternative)
# GOOGLE_APPLICATION_CREDENTIALS=
# GCS_BUCKET=tesla-forecasting-data

# Feature Flags
ENABLE_DEEP_LEARNING=false
ENABLE_WHAT_IF_SCENARIOS=true
ENABLE_EXPERIMENT_TRACKING=true

# Monitoring
ENABLE_METRICS=true
ENABLE_TRACING=false